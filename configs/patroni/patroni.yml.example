# Vorlage – knotenspezifische Werte (<...>) pro Knoten anpassen.
# Passwörter stehen NICHT hier, sondern in /etc/patroni/patroni.env
# (PATRONI_SUPERUSER_PASSWORD, PATRONI_REPLICATION_PASSWORD).
scope: postgres-ha
name: <ph-nodeX>

restapi:
  listen: <NODE_IP>:8008
  connect_address: <NODE_IP>:8008

etcd3:
  hosts: 192.168.178.201:2379,192.168.178.202:2379,192.168.178.203:2379

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 5
        max_replication_slots: 5
        archive_mode: "on"
        archive_command: 'cp %p /var/lib/postgresql/wal_archive/%f'
  initdb:
    - encoding: UTF8
    - data-checksums
  pg_hba:
    - host replication replicator 192.168.178.0/24 scram-sha-256
    - host all all 192.168.178.0/24 scram-sha-256

postgresql:
  listen: <NODE_IP>:5432
  connect_address: <NODE_IP>:5432
  data_dir: /var/lib/postgresql/16/patroni
  bin_dir: /usr/lib/postgresql/16/bin
  authentication:
    superuser:
      username: postgres     # Passwort via PATRONI_SUPERUSER_PASSWORD
    replication:
      username: replicator   # Passwort via PATRONI_REPLICATION_PASSWORD

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
