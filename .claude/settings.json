{
  "permissions": {
    "allow": [
      "Bash(patronictl list:*)",
      "Bash(etcdctl endpoint health:*)",
      "Bash(etcdctl member list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./configs/**/*.env)",
      "Read(./configs/**/patroni.yml)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous.sh"
          }
        ]
      }
    ]
  }
}
